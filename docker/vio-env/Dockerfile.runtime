ARG BASE_IMAGE=roboego-vio-env:dev
FROM ${BASE_IMAGE} AS build
COPY --from=openvins ov_core /opt/open_vins/ov_core
COPY --from=openvins ov_init /opt/open_vins/ov_init
COPY --from=openvins ov_msckf /opt/open_vins/ov_msckf
COPY --from=openvins ov_offline /opt/open_vins/ov_offline
RUN rm -rf /opt/open_vins/ov_msckf/build \
    && cmake -S /opt/open_vins/ov_msckf -B /opt/open_vins/ov_msckf/build \
       -G Ninja -DENABLE_ROS=OFF -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/open_vins/ov_msckf/build \
       --target roboego_openvins_offline offline_timing_test --parallel 2 \
    && /opt/open_vins/ov_msckf/build/offline_timing_test

FROM ${BASE_IMAGE}
ARG PROJECT_REVISION=unknown
ARG OPENVINS_REVISION=unknown
LABEL org.opencontainers.image.title="RoboEgo ROS-free VIO runtime" \
      org.opencontainers.image.revision="${PROJECT_REVISION}" \
      io.roboego.openvins.revision="${OPENVINS_REVISION}"
COPY --from=build /opt/open_vins/ov_msckf/build/openvins_offline_native /opt/open_vins/ov_msckf/build/
COPY --from=build /opt/open_vins/ov_msckf/build/roboego_openvins_offline /opt/open_vins/ov_msckf/build/
COPY --from=build /opt/open_vins/ov_msckf/build/libov_msckf_lib.so /opt/open_vins/ov_msckf/build/
COPY --from=openvins ov_offline /opt/open_vins/ov_offline
COPY --from=openvins LICENSE /opt/open_vins/LICENSE
COPY --from=project roboego_hand_vis/__init__.py /opt/roboego-hand-vis/roboego_hand_vis/
COPY --from=project roboego_hand_vis/common /opt/roboego-hand-vis/roboego_hand_vis/common
COPY --from=project roboego_hand_vis/vio /opt/roboego-hand-vis/roboego_hand_vis/vio
COPY --from=project tests/vio /opt/roboego-hand-vis/tests/vio
RUN python3 -c 'from pathlib import Path; import yaml; p=Path("/opt/roboego-hand-vis/roboego_hand_vis/vio/recommended.yaml"); c=yaml.safe_load(p.read_text()); c["openvins"]={"root": "/opt/open_vins", "binary": "/opt/open_vins/ov_msckf/build/roboego_openvins_offline"}; p.write_text(yaml.safe_dump(c, sort_keys=False))'
COPY runtime-entry.sh /usr/local/bin/vio-runtime
COPY runtime-output.py /usr/local/lib/vio-runtime/runtime-output.py
COPY tests /usr/local/lib/vio-runtime/tests
ENV PYTHONPATH=/opt/roboego-hand-vis:/opt/open_vins \
    LD_LIBRARY_PATH=/opt/open_vins/ov_msckf/build \
    VIO_PROJECT_REVISION=${PROJECT_REVISION} VIO_OPENVINS_REVISION=${OPENVINS_REVISION} \
    HOME=/tmp/vio-home
WORKDIR /opt/roboego-hand-vis
ENTRYPOINT ["/bin/bash", "/usr/local/bin/vio-runtime"]
CMD ["doctor"]
